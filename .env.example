# Public client configuration. next.config.ts exposes only these two values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Stripe (local only, never exposed to the browser). Used by scripts/stripe-setup.mjs.
# The Edge Functions read the same two values from Supabase Edge Function secrets.
STRIPE_SECRET_KEY=sk_test_<your-sandbox-secret-key>
# Written by scripts/stripe-setup.mjs when it creates the webhook.
STRIPE_WEBHOOK_SECRET=whsec_<written-by-setup-script>
